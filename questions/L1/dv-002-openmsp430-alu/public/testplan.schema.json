{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tests structural schema",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "stimulus",
          "expected",
          "checker",
          "requirement_ids",
          "feature_ids"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "stimulus": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "checker": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "implementation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "enum": [
                "R-dv-002-001",
                "R-dv-002-002",
                "R-dv-002-003",
                "R-dv-002-004",
                "R-dv-002-005",
                "R-dv-002-006"
              ]
            }
          },
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  },
  "description": "Unique IDs, reference existence, parent cycles, and Markdown semantic consistency are checked separately by the actual entry point/review; A/E additionally require implementation_id/source. This schema does not replace semantic evaluation."
}
