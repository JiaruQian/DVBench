{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "features structural schema",
  "type": "object",
  "required": [
    "features"
  ],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "module",
          "definition",
          "timing",
          "boundary",
          "requirement_ids",
          "interface"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timing": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "enum": [
                "R-dv-001-001",
                "R-dv-001-002"
              ]
            }
          },
          "interface": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "description": "Unique IDs, reference existence, parent cycles, and Markdown semantic consistency are checked separately by the actual entry point/review; A/E additionally require implementation_id/source. This schema does not replace semantic evaluation."
}
