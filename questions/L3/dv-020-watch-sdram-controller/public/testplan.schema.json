{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "stimulus",
          "expected",
          "checker",
          "feature_ids",
          "requirement_ids",
          "implementation_id",
          "source"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "stimulus": {
            "type": "string",
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "pattern": "\\S"
          },
          "checker": {
            "type": "string",
            "pattern": "\\S"
          },
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "implementation_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$comment": "Unique local IDs, reference membership, hierarchy and filelist rules are checked by the documented runtime validator."
}
