        "io_rf_read_ports_4_data",
        "io_rf_read_ports_5_addr",
        "io_rf_read_ports_5_data"
      ],
      "anchors": {
        "0": "Missing or incorrect behavior.",
        "1": "Correct partial domain with important boundaries omitted.",
        "2": "Complete accurate conditions, behavior and stated boundaries."
